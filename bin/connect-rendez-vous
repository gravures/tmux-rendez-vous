#!/usr/bin/env bash
#
# Create / Connect / Restore tmux sessions
#

session=${1}
if [[ -z ${session} ]]; then exit 0; fi

##
# check if session should be restored
# sleepings=$(comm -23 <(lazy-tmux list | cut -f1 | sort) <(tmux list-sessions -F '#{session_name}' | sort))
sleepings=$(list-rendez-vous --sleep)
for item in ${sleepings}; do
	if [[ ${item} == "${session}" ]]; then
		sleep_=true
		break
	fi
done

##
# Let sesh handle session operations
if [[ ! -v sleep_ ]]; then
	sesh connect "${session}"
	exit
fi

##
# Acquire sessions operations lock
# shellcheck source-path=../tmux-bash-lib/lib
source bash::string.sh
# shellcheck source-path=../tmux-bash-lib/lib
source bash::mutex.sh
declare -r MUTEX_SESSIONS_OP_LOCK=${MUTEX_LOCK_DIR}/sessions_op.lock

# shellcheck disable=SC2317
on_exit() {
	mutex::unlock "${MUTEX_SESSIONS_OP_LOCK}"
	trap - INT TERM EXIT
}
if ! mutex::lock ${MUTEX_SESSIONS_OP_LOCK} 2>/dev/null; then exit 0; fi
trap on_exit INT TERM EXIT

##
# Restoration
#
str::split "$(tmux show -gv '@rendez-vous-restore-before-hook')" before_hook ' '
str::split "$(tmux show -gv '@rendez-vous-restore-after-hook')" after_hook ' '

if command -v "${before_hook[0]}" &>/dev/null; then
	before_hook+=("${session}")
	rdv-notify "${before_hook[*]}" "${before_hook[0]}"
fi

##
# FIXME: follow [issue #105](https://github.com/alchemmist/lazy-tmux/issues/105)
rdv-notify "lazy-tmux wakeup --session ${session}" 'restoring session'

# run user after hook
if command -v "${after_hook[0]}" &>/dev/null; then
	after_hook+=("${session}")
	rdv-notify "${after_hook[*]}" "${after_hook[0]}"
fi

# connect if user opt-in
[[ "$(tmux show -gv '@rendez-vous-connect-after-restore')" == "on" ]] &&
	sesh connect "${session}"
