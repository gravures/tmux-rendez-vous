#!/usr/bin/env bash
#
# _rdv_daemon

# Safe guard against corrupted environment
_path="$(tmux show-environment -g PATH)"
export PATH="$PATH:${_path##*=}"

declare -r INTERVAL=$(($(tmux show -gv '@rendez-vous-save-daemon-interval') * 60))

# shellcheck source-path=../tmux-bash-lib/lib
source bash::mutex.sh

##
# Daemon Status
if [[ $(tty) != "not a tty" ]]; then
	tmux run -b rdv-saver-daemon &> /dev/null
	exit 0
fi

if ! mutex::lock &> /dev/null; then exit 0; fi

# shellcheck disable=SC2317
on_exit() {
	[[ ${sleep_pid} ]] && kill "${sleep_pid}"
	mutex::unlock 2> /dev/null
	trap - INT TERM EXIT
}
printf 'rdv-saver-daemon' > /proc/$$/comm
trap on_exit INT TERM EXIT

##
# Main Loop
while mutex::locked; do
	# begin with a quiet sleep
	sleep "${INTERVAL}" &
	sleep_pid=$!
	# If sleep was interrupted (e.g., by SIGKILL),
	# exit loop before running save job.
	if ! wait ${sleep_pid}; then break; fi
	unset sleep_pid

	# this will wait after the saving process,
	# if daemon is SIGKILL it will exit
	# but saving process will continue to run
	# on the background.
	save-rendez-vous &
	wait $!
done

exit
