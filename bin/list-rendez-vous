#!/usr/bin/env bash
#
# List:
#   - active tmux sessions
#   - unactived stored session
#   - zoxide directories
#
# each item has an icon prepend
#
for opt in "${@}"; do
	case ${opt} in
	--icons) icon=--icons ;;
	--tmux | -t) tmux=true ;;
	--sleep | -s) sleep=true ;;
	--config | -c) config=true ;;
	--zoxide | -z) zoxide=true ;;
	*) : ;;
	esac
done

if [[ ! -v tmux ]] && [[ ! -v sleep ]] && [[ ! -v config ]] && [[ ! -v zoxide ]]; then
	tmux=true
	sleep=true
	config=true
	zoxide=true
fi

tmp=$(sesh list --tmux)

if [[ -v tmux ]]; then
	while IFS= read -r line; do
		[[ -n ${line} ]] && result+="${line}\n"
	done < <(sesh list --tmux "${icon}")
fi

# FIXME: regex filter could skip session name (eg: tmux)
if [[ -v sleep ]]; then
	[[ ${icon} ]] && ic=" "
	while IFS= read -r line; do
		[[ -z ${line} ]] || [[ "\n${tmp}\n" =~ [^.](${line})[^.] ]] && continue
		result+="${ic}${line}\n"
	done < <(lazy-tmux list | cut -f1)
fi

if [[ -v config ]]; then
	while IFS= read -r line; do
		[[ -n ${line} ]] && result+="${line}\n"
	done < <(sesh list --config "${icon}")
fi

if [[ -v zoxide ]]; then
	while IFS= read -r line; do
		[[ -n ${line} ]] && result+="${line}\n"
	done < <(sesh list --zoxide "${icon}")
fi

printf '%b' "${result%%}"
