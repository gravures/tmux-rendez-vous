#!/usr/bin/env bash
#
# Session-Chooser
#
# TODO: rework picker actions
# TODO: make an action that will close a session withot save

tmux run 'list-rendez-vous --icons' | fzf --tmux 80%,70%,border-native \
	--style full \
	--layout reverse \
	--margin 2%,1%,4%,1% \
	--padding 0,0,4%,0 \
	--input-label ' rendez-vous ' \
	--border bottom \
	--border-label ' <C-a> all ● <C-t> tmux ● <C-s> sleeping ● <C-g> configs ● <C-x> zoxide ● <C-d> close ● <C-f> find ' \
	--ghost search \
	--list-label ' results ' \
	--no-sort --ansi \
	--scrollbar '▉' \
	--pointer '▶' \
	--color 'pointer:magenta,ghost:grey,input-fg:magenta,gutter:black' \
	--prompt '⚡  ' \
	--bind 'tab:down,btab:up' \
	--bind 'enter,double-click:become(connect-rendez-vous {2..})' \
	--bind 'ctrl-a:change-prompt(⚡  )+reload(list-rendez-vous --icons)' \
	--bind 'ctrl-t:change-prompt(🪟  )+reload(list-rendez-vous -t --icons)' \
	--bind 'ctrl-s:change-prompt(  )+reload(list-rendez-vous -s --icons)' \
	--bind 'ctrl-g:change-prompt(⚙️  )+reload(list-rendez-vous -c --icons)' \
	--bind 'ctrl-x:change-prompt(📁  )+reload(list-rendez-vous -z --icons)' \
	--bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
	--bind 'ctrl-d:execute(tmux run "close-rendez-vous {2..}")+change-prompt(⚡  )+reload(list-rendez-vous --icons)' \
	--preview-window 'right:50%' \
	--preview 'sesh preview {}'

exit 0
