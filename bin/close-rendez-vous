#!/usr/bin/env bash
#
# Close-Rendez-Vous command

# Safe guard against corrupted environment
_path="$(tmux show-environment -g PATH)"
export PATH="$PATH:${_path##*=}"

forget=false

while true; do
	case ${1} in
		--kill | -k)
			forget=true
			shift 1
			;;
		-*)
			tmux display-message -d 5000 "close-rendez-vous: invalid option '${1}'"
			exit 1
			;;
		*)
			break
			;;
	esac
done

session=${1}
if [[ -z ${session} ]]; then exit 0; fi

# test if session is alive
while IFS= read -r item; do
	if [[ ${item} == "${session}" ]]; then
		tmux run "save-rendez-vous ${session}" \
			&& tmux kill-session -t "${session}"
	fi
done < <(printf '%s\n' "$(sesh list --tmux)")

if ! ${forget}; then
	exit
fi

# check if session is a saved item
while IFS= read -r item; do
	if [[ ${item} == "${session}" ]]; then
		lazy-tmux forget --session "${session}"
	fi
done < <(printf '%s\n' "$(lazy-tmux list | cut -f1)")
