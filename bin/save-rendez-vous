#!/usr/bin/env bash
#
# Save-Rendez-Vous command

# Safe guard against corrupted environment
_path="$(tmux show-environment -g PATH)"
export PATH="$PATH:${_path##*=}"

# shellcheck source-path=../tmux-bash-lib/lib
source bash::string.sh
# shellcheck source-path=../tmux-bash-lib/lib
source bash::mutex.sh
declare -r MUTEX_SESSIONS_OP_LOCK=${MUTEX_LOCK_DIR}/sessions_op.lock

# shellcheck disable=SC2317
on_exit() {
	mutex::unlock "${MUTEX_SESSIONS_OP_LOCK}"
	trap - INT TERM EXIT
}

##
# Acquire sessions operations lock
if ! mutex::lock ${MUTEX_SESSIONS_OP_LOCK} 2>/dev/null; then exit 0; fi
trap on_exit INT TERM EXIT
printf save-rdv >/proc/$$/comm

##
# Job start here
sessions=("${@}")
str::split "$(tmux show -gv '@rendez-vous-save-before-hook')" before_hook ' '
str::split "$(tmux show -gv '@rendez-vous-save-after-hook')" after_hook ' '
scrollback=$(tmux show -gv '@rendez-vous-save-scrollback')

##
# Save all opened sessions list
ALL="$(list-rendez-vous --tmux)"
if STATE_DIRECTORY=$(tmux show-environment -g TMUX_RDV_STATE); then
	STATE_DIRECTORY=${STATE_DIRECTORY#TMUX_RDV_STATE=*}
	echo "$ALL" > "${STATE_DIRECTORY}/sessions"
	"$(tmux display -p '#{session_name}')" > "${STATE_DIRECTORY}/current"
fi

##
# Setup lazy-tmux options
lazy_tmux_opts=()
(( "${#sessions[@]}" == 0 )) && str::split "${ALL}" sessions
[[ ${scrollback} == "on" ]] && lazy_tmux_opts+=('--scrollback')

##
# pre-hook
if command -v "${before_hook[0]}" &>/dev/null; then
	before_hook+=("${sessions[@}]")
	rdv-notify "${before_hook[*]}" "${before_hook[0]}"
fi

##
# Lazy-tmux task
for session in "${sessions[@]}"; do
	rdv-notify "lazy-tmux save ${lazy_tmux_opts[*]} --session ${session}" "save ${session}"
done

##
# sessions linked-windows handling
rdv-notify "verify-linked-windows save ${sessions[*]}" 'save linked windows'

##
# post-hook
if command -v "${after_hook[0]}" &>/dev/null; then
	after_hook+=("${sessions[@]}")
	rdv-notify "${after_hook[*]}" "${after_hook[0]}"
fi

exit ${?}
