#!/usr/bin/env bash
#
# Save-Rendez-Vous command
#
declare -r COMMAND_LOCK="/tmp/rdv-session.lock"

source bash_mutex

# shellcheck disable=SC2317
on_exit() {
	rm -f "${COMMAND_LOCK}" 2>/dev/null
	trap - INT TERM EXIT
}

##
# lazy-tmux sessions operations lock
if ! mutex ${COMMAND_LOCK} 2>/dev/null; then exit 0; fi
trap on_exit INT TERM EXIT
printf save-rdv >/proc/$$/comm

##
# Assert lazy-tmux is not operating
try=0
while ps -C lazy-tmux &>/dev/null; do
	if ((try > 2)); then
		echo "lazy-tmux is already running, couldn't proceed with saving job" >&2
		exit 1
	fi
	try=$((try + 1))
	sleep 3
done

##
# Job start here
sessions=("${@}")
readarray -t before_hook < <(tmux show -gv '@rendez-vous-save-before-hook')
readarray -t after_hook < <(tmux show -gv '@rendez-vous-save-after-hook')
scrollback=$(tmux show -gv '@rendez-vous-save-scrollback')

[[ "${#sessions[@]}" -eq 0 ]] && sessions=('--all')
[[ ${scrollback} == "on" ]] && sessions+=('--scrollback')

if command -v "${before_hook[0]}" &>/dev/null; then
	before_hook+=("${@}")
	rdv-notify "${before_hook[*]}" "${before_hook[0]}"
fi

if ! rdv-notify "lazy-tmux save ${sessions[*]}" 'saving session'; then
	exit 1
fi

if command -v "${after_hook[0]}" &>/dev/null; then
	after_hook+=("${@}")
	rdv-notify "${after_hook[*]}" "${after_hook[0]}"
fi

exit ${?}
