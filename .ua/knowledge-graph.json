  "tour": [
    {
      "order": 1,
      "title": "Project Overview",
      "description": "Start with the agent guidelines to understand the project's purpose, architecture, and agent conventions. This document explains the plugin's role as a Tmux TPM plugin for session management.",
      "nodeIds": []
    },
    {
      "order": 2,
      "title": "Plugin Bootstrap & PATH Injection",
      "description": "Explore plugin.tmux — the main entry point tmux sources at startup. Understand how it validates runtime requirements (Tmux 3.6+, Bash 4.4+), requires external commands (sesh, lazy-tmux, fzf), sets default options, and injects bin/ into the shell PATH so all commands become available.",
      "nodeIds": []
    },
    {
      "order": 3,
      "title": "Session Listing Engine",
      "description": "Dive into list-rendez-vous — the core data layer that aggregates sessions from multiple sources (tmux, sleeping, config, zoxide) and provides filtering flags. This is the foundation that other commands depend on.",
      "nodeIds": [
        "file:bin/list-rendez-vous"
      ]
    },
    {
      "order": 4,
      "title": "Session Persistence & Lifecycle",
      "description": "Examine save-rendez-vous and close-rendez-vous together — the save/close lifecycle. Save handles mutex locking, hook support, and scrollback preservation. Close orchestrates saving via lazy-tmux then killing sessions, with options to force forget or kill. Note how close-rendez-vous calls save-rendez-vous, which in turn calls list-rendez-vous.",
      "nodeIds": [
        "function:bin/save-rendez-vous:on_exit",
        "file:bin/close-rendez-vous"
      ]
    },
    {
      "order": 5,
      "title": "Interactive Session Picker",
      "description": "End with rendez-vous-picker — the fzf-based interactive UI that ties everything together. It calls list-rendez-vous to aggregate sources and close-rendez-vous for cleanup, presenting keyboard shortcuts for filtering and actions. This is the primary user-facing tool.",
      "nodeIds": [
        "file:bin/rendez-vous-picker"
      ]
    }
